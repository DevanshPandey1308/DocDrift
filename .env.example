# Docker Compose local development configuration.
# Copy this file to .env, then replace the required placeholders.

# Required for verified GitHub webhook intake.
DOCDRIFT_GITHUB_WEBHOOK_SECRET=replace-with-a-random-local-webhook-secret

# Required for the API, migration service, and worker inside Compose.
DOCDRIFT_DATABASE_URL=postgresql+asyncpg://docdrift@postgres:5432/docdrift
DOCDRIFT_REDIS_URL=redis://redis:6379/0

# Required for GitHub App repository sync and Check Run publication.
DOCDRIFT_GITHUB_APP_ID=replace-with-numeric-app-id
DOCDRIFT_GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# Optional alternative to the mounted PEM path; path takes precedence.
DOCDRIFT_GITHUB_APP_PRIVATE_KEY=

# Required for dashboard sign-in; use the registered callback URL.
DOCDRIFT_GITHUB_OAUTH_CLIENT_ID=replace-with-oauth-client-id
DOCDRIFT_GITHUB_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret
DOCDRIFT_SESSION_ENCRYPTION_KEY=replace-with-generated-fernet-key
DOCDRIFT_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
DOCDRIFT_DASHBOARD_ORIGIN=http://localhost:5173
# Required for local HTTP; use true behind HTTPS in production.
DOCDRIFT_DASHBOARD_COOKIE_SECURE=false

# Optional API metadata.
DOCDRIFT_API_TITLE=DocDrift API
DOCDRIFT_API_VERSION=0.1.0

# Optional grounded LLM verification. Disabled by default.
DOCDRIFT_LLM_ENABLED=false
ANTHROPIC_API_KEY=
DOCDRIFT_ANTHROPIC_VERIFICATION_MODEL=
DOCDRIFT_ANTHROPIC_FIX_MODEL=
DOCDRIFT_LLM_TIMEOUT_SECONDS=20
DOCDRIFT_LLM_RUN_TOKEN_BUDGET=20000
